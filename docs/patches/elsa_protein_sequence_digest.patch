+# Order-free digest of the (protein_id, sequence) pairs in a Sharur core database's
+# ``proteins`` table. Sharur compares the recorded value with its live table, which
+# exposes re-called or corrected translations under an unchanged gene layout. Keep
+# the SQL byte-identical to ``sharur.synteny.PROTEIN_SEQUENCE_DIGEST_SQL`` and the
+# algorithm name in step with any change; both sides pin the same golden value.
+PROTEIN_SEQUENCE_DIGEST_ALGORITHM = "protein-sequence-md5-sum-v1"
+PROTEIN_SEQUENCE_DIGEST_SQL = """
+WITH element AS (
+    SELECT md5(COALESCE(md5(sequence), repeat('-', 32)) || protein_id) AS h
+    FROM proteins
+)
+SELECT
+    COUNT(*) AS protein_count,
+    md5(
+        CAST(COUNT(*) AS VARCHAR) || ':'
+        || CAST(COALESCE(SUM(('0x' || substr(h, 1, 16))::UBIGINT), 0)::HUGEINT AS VARCHAR) || ':'
+        || CAST(COALESCE(SUM(('0x' || substr(h, 17, 16))::UBIGINT), 0)::HUGEINT AS VARCHAR)
+    ) AS digest
+FROM element
+"""
 
+
