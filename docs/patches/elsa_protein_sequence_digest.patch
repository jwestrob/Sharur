+def protein_sequence_digest(
+    db_path: str | Path,
+    *,
+    threads: int | None = None,
+) -> dict[str, Any]:
+    """Return the order-free protein-sequence digest of a Sharur core database.
+
+    The database is opened read-only. The result is a run-manifest input
+    artifact (``input_artifacts["protein_sequences"]``).
+    """
+
+    resolved = Path(db_path).expanduser().resolve()
+    config = {"threads": int(threads)} if threads is not None else {}
+    connection = duckdb.connect(str(resolved), read_only=True, config=config)
+    try:
+        count, digest = connection.execute(PROTEIN_SEQUENCE_DIGEST_SQL).fetchone()
+    finally:
+        connection.close()
+    return {
+        "algorithm": PROTEIN_SEQUENCE_DIGEST_ALGORITHM,
+        "digest": str(digest),
+        "protein_count": int(count),
+        "path": str(resolved),
+    }
+
+
+def embedding_manifest_fingerprint(embeddings_path: str | Path) -> dict[str, Any] | None:
+    """Fingerprint the Sharur ``embedding_manifest.json`` beside an embedding H5.
+
+    Records the encoder model name with the manifest's SHA-256; returns None
+    when the manifest is absent.
+    """
+
+    manifest = Path(embeddings_path).expanduser().resolve().parent / "embedding_manifest.json"
+    if not manifest.is_file():
+        return None
+    payload = json.loads(manifest.read_text())
+    return {
+        **fingerprint_file(manifest),
+        "model_name": payload.get("model_name") if isinstance(payload, dict) else None,
+        "embedding_dim": payload.get("embedding_dim") if isinstance(payload, dict) else None,
+    }
+
