+# Shared with Sharur's tests/test_synteny.py, which pins the same value for the same rows.
+GOLDEN_SEQUENCE_ROWS = [("p1", "MKV"), ("p10", "MA"), ("q2", None), ("q3", "")]
+GOLDEN_SEQUENCE_DIGEST = "f3a85170cd50c5ae9114999152561214"
+
+
+def _core_with_sequences(path, rows) -> None:
+    connection = duckdb.connect(str(path))
+    connection.execute("CREATE TABLE proteins(protein_id VARCHAR, sequence VARCHAR)")
+    connection.executemany("INSERT INTO proteins VALUES (?, ?)", rows)
+    connection.close()
+
+
+def test_protein_sequence_digest_is_order_free_and_pinned(tmp_path):
+    digests = []
+    for name, rows in (("forward", GOLDEN_SEQUENCE_ROWS), ("reverse", GOLDEN_SEQUENCE_ROWS[::-1])):
+        core = tmp_path / f"{name}.duckdb"
+        _core_with_sequences(core, rows)
+        digests.append(protein_sequence_digest(core, threads=1))
+
+    assert digests[0]["digest"] == digests[1]["digest"] == GOLDEN_SEQUENCE_DIGEST
+    assert digests[0]["algorithm"] == PROTEIN_SEQUENCE_DIGEST_ALGORITHM
+    assert digests[0]["protein_count"] == 4
+
+
+def test_protein_sequence_digest_sql_matches_sharur():
+    sharur_synteny = pytest.importorskip("sharur.synteny")
+    if not hasattr(sharur_synteny, "PROTEIN_SEQUENCE_DIGEST_SQL"):
+        pytest.skip("the installed Sharur predates the protein-sequence digest")
+    assert PROTEIN_SEQUENCE_DIGEST_SQL == sharur_synteny.PROTEIN_SEQUENCE_DIGEST_SQL
+    assert PROTEIN_SEQUENCE_DIGEST_ALGORITHM == sharur_synteny.PROTEIN_SEQUENCE_DIGEST_ALGORITHM
+
+
+def test_materialize_results_records_sequence_digest_on_request(tmp_path):
+    from click.testing import CliRunner
+
+    from elsa.cli import main
+
+    results = tmp_path / "results"
+    results.mkdir()
+    _blocks().to_csv(results / "micro_chain_blocks.csv", index=False)
+    store = tmp_path / "store"
+    store.mkdir()
+    _genes().to_parquet(store / "metadata.parquet")
+    (store / "embeddings.npy").write_bytes(b"placeholder")
+    (store / "config.json").write_text("{}")
+    core = tmp_path / "sharur.duckdb"
+    _core_with_sequences(core, GOLDEN_SEQUENCE_ROWS)
+
+    recorded = {}
+    run_ids = {}
+    for name, extra in (("without", []), ("with", ["--sequence-db", str(core)])):
+        sidecar = tmp_path / f"{name}.duckdb"
+        result = CliRunner().invoke(
+            main,
+            [
+                "materialize-results", str(results), "--store", str(store),
+                "--result-db", str(sidecar), "--threads", "1", *extra,
+            ],
+        )
+        assert result.exit_code == 0, result.output
+        connection = duckdb.connect(str(sidecar), read_only=True)
+        run_id, inputs_json = connection.execute(
+            "SELECT run_id, inputs_json FROM current_elsa_run"
+        ).fetchone()
+        connection.close()
+        recorded[name] = json.loads(inputs_json).get("protein_sequences")
+        run_ids[name] = run_id
+
+    assert recorded["without"] is None
+    assert recorded["with"]["digest"] == GOLDEN_SEQUENCE_DIGEST
+    assert recorded["with"]["algorithm"] == PROTEIN_SEQUENCE_DIGEST_ALGORITHM
+    assert run_ids["with"] != run_ids["without"]  # the sequences are part of the run identity
